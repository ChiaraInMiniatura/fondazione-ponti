{
    "name": "bluelabs/bluelabs-tema",
    "type": "wordpress-theme",
    "license": "MIT",
    "description": "Tema WordPress basato su Sage (Blade + Vite + Tailwind + Acorn)",
    "require": {
        "php": ">=8.2",
        "roots/acorn": "^5.0"
    },
    "extra": {
        "acorn": {
            "providers": [
                "App\\Providers\\ThemeServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
